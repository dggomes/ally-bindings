<Window x:Class="AllyBindings.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" Height="150"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" IsHitTestVisible="False">
  <Border Background="#EE171821" BorderBrush="#667C5CFC" BorderThickness="1"
          CornerRadius="22" Padding="26" Effect="{DynamicResource OverlayShadow}">
    <Border.Resources>
      <DropShadowEffect x:Key="OverlayShadow" BlurRadius="24" ShadowDepth="8" Opacity="0.5" />
    </Border.Resources>
    <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="EyebrowText" Text="ALLY BINDINGS" Foreground="#A7A9B8"
                 FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock x:Name="SelectionText" Text="Default" Foreground="White"
                 FontSize="30" FontWeight="SemiBold" Margin="0,6,0,3"
                 TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
      <TextBlock x:Name="DetailText" Text="Release to choose" Foreground="#C7C8D2"
                 FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" />
    </StackPanel>
  </Border>
</Window>
