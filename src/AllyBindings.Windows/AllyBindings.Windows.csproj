<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AllyBindings</AssemblyName>
    <RootNamespace>AllyBindings.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AllyBindings.ico</ApplicationIcon>

    <RepositoryUrl>https://github.com/dggomes/ally-bindings</RepositoryUrl>
    <PublishSingleFile>true</PublishSingleFile>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\AllyBindings.ico" />
    <Resource Include="Assets\AllyBindings.png" />
    <EmbeddedResource Include="..\..\native\ArmouryTap\build\Release\AllyBindings.ArmouryTap.dll"
                      LogicalName="AllyBindings.Windows.Native.AllyBindings.ArmouryTap.dll"
                      Condition="Exists('..\..\native\ArmouryTap\build\Release\AllyBindings.ArmouryTap.dll')" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.5" />
    <ProjectReference Include="..\AllyBindings.Core\AllyBindings.Core.csproj" />
    <PackageReference Include="HidSharp" Version="2.6.4" />
  </ItemGroup>
</Project>
