<Application x:Class="AllyBindings.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#8B73FF" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#A99AFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#0E111B" />
    <SolidColorBrush x:Key="PanelBrush" Color="#171C2A" />
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="#202638" />
    <SolidColorBrush x:Key="MutedBrush" Color="#AEB5C7" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#62D6A7" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F5C56B" />

    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
      <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="MinWidth" Value="92" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#394157" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#2A3146" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#6652D8" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentStrongBrush}" />
                <Setter TargetName="Chrome" Property="BorderThickness" Value="3" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#6F58E8" />
      <Setter Property="BorderBrush" Value="#A99AFF" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="0,5,0,12" />
      <Setter Property="Background" Value="#111624" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#394157" />
      <Setter Property="CaretBrush" Value="White" />
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="0,5,0,10" />
      <Setter Property="Background" Value="#111624" />
      <!-- The stock Windows ComboBox template renders a light field; dark text remains readable across themes. -->
      <Setter Property="Foreground" Value="#111624" />
      <Setter Property="BorderBrush" Value="#394157" />
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="4" />
    </Style>

    <Style TargetType="ListBoxItem">
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ItemChrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2"
                    CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#252C40" /></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemChrome" Property="Background" Value="#302A59" />
                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{StaticResource AccentStrongBrush}" />
                <Setter TargetName="ItemChrome" Property="BorderThickness" Value="3" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
