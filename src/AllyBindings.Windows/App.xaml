<Application x:Class="AllyBindings.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFC" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#171821" />
    <SolidColorBrush x:Key="PanelBrush" Color="#222430" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A7A9B8" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,4,0,10" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Margin" Value="0,4,0,10" />
    </Style>
  </Application.Resources>
</Application>
