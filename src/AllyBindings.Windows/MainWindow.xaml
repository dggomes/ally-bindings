<Window x:Class="AllyBindings.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:AllyBindings.Core;assembly=AllyBindings.Core"
        Title="Ally Bindings" Width="1380" Height="820" MinWidth="900" MinHeight="600"
        Background="{StaticResource SurfaceBrush}" Foreground="White"
        Icon="Assets/AllyBindings.ico" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="82" />
      <RowDefinition Height="*" />
      <RowDefinition Height="52" />
    </Grid.RowDefinitions>

    <!-- Always-visible product header and updater. -->
    <Border Grid.Row="0" Background="#121725" BorderBrush="#272E40" BorderThickness="0,0,0,1" Padding="22,12">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Image Source="Assets/AllyBindings.png" Width="52" Height="52" Margin="0,0,14,0" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Ally Bindings" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="Controller-first profiles for your ROG Ally" Foreground="{StaticResource MutedBrush}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="13,8" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="ControllerDot" Width="10" Height="10" Fill="#ECA94D" Margin="0,0,8,0" />
              <TextBlock x:Name="ControllerStatusText" Text="Looking for controller…" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Button x:Name="HeaderUpdateButton" Style="{StaticResource PrimaryButton}" Content="Update app" Click="CheckForUpdates_Click"
                  AutomationProperties.Name="Check for and install Ally Bindings updates" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Large persistent destinations are reachable by touch or LB/RB. -->
      <Border Grid.Column="0" Background="#121725" BorderBrush="#272E40" BorderThickness="0,0,1,0" Padding="14">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <ListBox x:Name="NavigationList" Background="Transparent" BorderThickness="0"
                   SelectedIndex="{Binding SelectedIndex, ElementName=WorkspaceTabs, Mode=TwoWay}"
                   SelectionChanged="NavigationList_SelectionChanged"
                   AutomationProperties.Name="App sections">
            <ListBoxItem AutomationProperties.Name="Profiles" AutomationProperties.AutomationId="NavigationProfiles">
              <StackPanel><TextBlock Text="Profiles" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Choose and manage" Foreground="{StaticResource MutedBrush}" /></StackPanel>
            </ListBoxItem>
            <ListBoxItem AutomationProperties.Name="Controller" AutomationProperties.AutomationId="NavigationController">
              <StackPanel><TextBlock Text="Controller" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Visual button mapping" Foreground="{StaticResource MutedBrush}" /></StackPanel>
            </ListBoxItem>
            <ListBoxItem AutomationProperties.Name="Shortcut" AutomationProperties.AutomationId="NavigationShortcut">
              <StackPanel><TextBlock Text="Shortcut" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Profile rotation chord" Foreground="{StaticResource MutedBrush}" /></StackPanel>
            </ListBoxItem>
            <ListBoxItem AutomationProperties.Name="Capture &amp; update" AutomationProperties.AutomationId="NavigationCaptureUpdate">
              <StackPanel><TextBlock Text="Capture &amp; update" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Armoury ETW and app care" Foreground="{StaticResource MutedBrush}" /></StackPanel>
            </ListBoxItem>
          </ListBox>
          <StackPanel Grid.Row="1" Margin="4,12,4,2">
            <TextBlock Text="LB / RB  Sections" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="D-pad  Navigate   ·   A  Select" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <TabControl x:Name="WorkspaceTabs" Grid.Column="1" SelectedIndex="0" Background="Transparent" Foreground="White" BorderThickness="0" Padding="0">
        <TabControl.Resources>
          <Style TargetType="TabItem"><Setter Property="Foreground" Value="White" /></Style>
        </TabControl.Resources>
        <TabControl.Template>
          <ControlTemplate TargetType="TabControl">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <Grid>
                <!-- Keep an items host so WPF generates the TabItem containers; hide only the headers. -->
                <ItemsPresenter Height="0" Width="0" Opacity="0" IsHitTestVisible="False" />
                <ContentPresenter x:Name="PART_SelectedContentHost"
                                  Margin="{TemplateBinding Padding}"
                                  ContentSource="SelectedContent"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
              </Grid>
            </Border>
          </ControlTemplate>
        </TabControl.Template>

        <!-- Profiles -->
        <TabItem>
          <Grid Margin="22">
            <Grid.ColumnDefinitions><ColumnDefinition Width="330" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="16">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Margin="4,0,0,12">
                  <TextBlock Text="Profiles" FontSize="24" FontWeight="SemiBold" />
                  <TextBlock Text="Pick what the controller rotates through." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ListBox x:Name="ProfilesList" Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.PanningMode="VerticalOnly"
                         AutomationProperties.Name="Controller profiles">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                          <TextBlock Text="Controller layout" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#302A59" CornerRadius="10" Padding="9,4" VerticalAlignment="Center">
                          <TextBlock Text="READY" FontSize="11" Foreground="#C9BEFF" FontWeight="Bold" />
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="＋ Add" Click="AddProfile_Click" />
                  <Button Content="Delete" Click="DeleteProfile_Click" IsEnabled="{Binding CanEditSelected}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="24">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock Text="Selected profile" Foreground="{StaticResource MutedBrush}" />
                  <TextBlock Text="{Binding SelectedProfile.Name}" FontSize="34" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,22,0,0">
                  <TextBlock Text="Profile name" Foreground="{StaticResource MutedBrush}" />
                  <Grid Margin="0,5,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Background="#111624" BorderBrush="#394157" BorderThickness="1" CornerRadius="9" Padding="14,11">
                      <TextBlock Text="{Binding SelectedProfile.Name}" FontSize="17" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <Button Grid.Column="1" Content="Rename" Click="RenameProfile_Click" IsEnabled="{Binding CanEditSelected}"
                            Margin="10,0,0,0" AutomationProperties.Name="Rename profile with controller keyboard" />
                  </Grid>
                  <CheckBox Content="Include in controller rotation" IsChecked="{Binding SelectedProfile.Enabled}" IsEnabled="{Binding CanEditSelected}" />
                </StackPanel>
                <Border Grid.Row="2" Background="#111624" CornerRadius="16" Padding="22" Margin="0,18,0,18">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Ready for the controller" FontSize="23" FontWeight="SemiBold" />
                    <TextBlock Text="Open Controller to edit the layout visually. Hold View + Menu outside this window to rotate enabled profiles."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <Button Content="Open controller mapping" Style="{StaticResource PrimaryButton}" Click="OpenControllerPage_Click"
                            HorizontalAlignment="Left" Margin="0,20,0,0" />
                  </StackPanel>
                </Border>
                <StackPanel Grid.Row="3" Orientation="Horizontal">
                  <Button Content="X  Save" Click="Save_Click" />
                  <Button Content="Y  Select profile" Style="{StaticResource PrimaryButton}" Click="Apply_Click" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </TabItem>

        <!-- Armoury-style full controller mapping -->
        <TabItem>
          <Grid Margin="18">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Choose a button to map" FontSize="27" FontWeight="SemiBold" />
                <TextBlock Text="Select any labelled physical control, then choose its output in the binding window."
                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
              </StackPanel>
              <ComboBox Grid.Column="1" Width="250" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                        DisplayMemberPath="Name" AutomationProperties.Name="Profile being mapped" />
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="12" Margin="0,12">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PanningMode="Both"
                            AutomationProperties.Name="Full controller button map"
                            AutomationProperties.AutomationId="ControllerMapScrollViewer">
                <Grid x:Name="ControllerMapSurface" MinWidth="800" MinHeight="350">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="600" />
                    <ColumnDefinition Width="100" />
                  </Grid.ColumnDefinitions>

                  <StackPanel VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding LeftBindings}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Tag="{Binding Row}" Click="BindingTile_Click" Height="48" Margin="0,0,6,0" Padding="6,3"
                                  HorizontalContentAlignment="Stretch"
                                  AutomationProperties.AutomationId="{Binding AutomationId}"
                                  IsEnabled="{Binding DataContext.CanEditSelected, RelativeSource={RelativeSource AncestorType=Window}}">
                            <AutomationProperties.Name>
                              <MultiBinding StringFormat="{}{0}, mapped to {1}">
                                <Binding Path="Label" /><Binding Path="Row.Target" />
                              </MultiBinding>
                            </AutomationProperties.Name>
                            <Grid>
                              <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /></Grid.ColumnDefinitions>
                              <Border Background="#302A59" BorderBrush="#5E4BB7" BorderThickness="1" CornerRadius="7" Width="30" Height="30">
                                <TextBlock Text="{Binding Glyph}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Row.Target}" Foreground="{StaticResource AccentStrongBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <TextBlock Grid.Column="2" Text="›" Foreground="{StaticResource MutedBrush}" FontSize="18" VerticalAlignment="Center" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Background="#111624" BorderBrush="#394157" BorderThickness="1" CornerRadius="10" Padding="3" Margin="0,2,6,0"
                            AutomationProperties.Name="D-pad mappings">
                      <ItemsControl ItemsSource="{Binding DPadBindings}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Tag="{Binding Row}" Click="BindingTile_Click" Height="48" Margin="1" Padding="3"
                                    AutomationProperties.AutomationId="{Binding AutomationId}" ToolTip="{Binding Row.Target}"
                                    IsEnabled="{Binding DataContext.CanEditSelected, RelativeSource={RelativeSource AncestorType=Window}}">
                              <AutomationProperties.Name>
                                <MultiBinding StringFormat="{}{0}, mapped to {1}">
                                  <Binding Path="Label" /><Binding Path="Row.Target" />
                                </MultiBinding>
                              </AutomationProperties.Name>
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontSize="17" FontWeight="Bold" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding Row.Target}" FontSize="9" Foreground="{StaticResource AccentStrongBrush}" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </StackPanel>

                  <Grid Grid.Column="1" Margin="4,0">
                    <Viewbox Stretch="Uniform" StretchDirection="Both">
                      <Canvas Width="700" Height="500" PreviewMouseLeftButtonUp="ControllerDiagram_PreviewMouseLeftButtonUp" PreviewTouchUp="ControllerDiagram_PreviewTouchUp">
                        <Canvas.Resources>
                          <Style x:Key="DiagramHitTarget" TargetType="Button">
                            <Setter Property="MinWidth" Value="56" />
                            <Setter Property="MinHeight" Value="56" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="#01000000" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="3" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Panel.ZIndex" Value="10" />
                            <Setter Property="Template">
                              <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                  <Border x:Name="HitBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" />
                                  <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                      <Setter TargetName="HitBorder" Property="Background" Value="#334F3FCF" />
                                      <Setter TargetName="HitBorder" Property="BorderBrush" Value="#C9BCFF" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                      <Setter TargetName="HitBorder" Property="Background" Value="#444F3FCF" />
                                      <Setter TargetName="HitBorder" Property="BorderBrush" Value="White" />
                                    </Trigger>
                                  </ControlTemplate.Triggers>
                                </ControlTemplate>
                              </Setter.Value>
                            </Setter>
                          </Style>
                        </Canvas.Resources>
                        <!-- Ally body and grips -->
                        <Path Data="M 86,142 C 111,91 168,67 224,81 L 476,81 C 532,67 589,91 614,142 L 659,320 C 671,367 643,410 599,421 L 506,358 L 194,358 L 101,421 C 57,410 29,367 41,320 Z"
                              Fill="#0D1320" Stroke="#F0F3FF" StrokeThickness="8" StrokeLineJoin="Round" />
                        <Path Data="M 194,358 C 166,378 130,404 101,421" Stroke="#8B73FF" StrokeThickness="5" Opacity="0.8" />
                        <Path Data="M 506,358 C 534,378 570,404 599,421" Stroke="#8B73FF" StrokeThickness="5" Opacity="0.8" />

                        <!-- Triggers and bumpers -->
                        <Rectangle Canvas.Left="105" Canvas.Top="67" Width="105" Height="28" RadiusX="12" RadiusY="12" Fill="#302A59" Stroke="#A99AFF" StrokeThickness="3" />
                        <Rectangle Canvas.Left="490" Canvas.Top="67" Width="105" Height="28" RadiusX="12" RadiusY="12" Fill="#302A59" Stroke="#A99AFF" StrokeThickness="3" />
                        <Rectangle Canvas.Left="124" Canvas.Top="94" Width="102" Height="25" RadiusX="10" RadiusY="10" Fill="#182235" Stroke="#EEF1FF" StrokeThickness="2" />
                        <Rectangle Canvas.Left="474" Canvas.Top="94" Width="102" Height="25" RadiusX="10" RadiusY="10" Fill="#182235" Stroke="#EEF1FF" StrokeThickness="2" />
                        <TextBlock Canvas.Left="145" Canvas.Top="70" Text="LT" FontSize="16" FontWeight="Bold" />
                        <TextBlock Canvas.Left="530" Canvas.Top="70" Text="RT" FontSize="16" FontWeight="Bold" />
                        <TextBlock Canvas.Left="160" Canvas.Top="96" Text="LB" FontSize="14" FontWeight="Bold" />
                        <TextBlock Canvas.Left="510" Canvas.Top="96" Text="RB" FontSize="14" FontWeight="Bold" />

                        <!-- Screen -->
                        <Rectangle Canvas.Left="225" Canvas.Top="118" Width="250" Height="192" RadiusX="12" RadiusY="12"
                                   Fill="#070A10" Stroke="#3A455C" StrokeThickness="5" />
                        <Rectangle Canvas.Left="238" Canvas.Top="132" Width="224" Height="164" RadiusX="5" RadiusY="5"
                                   Fill="#111A29" Stroke="#8B73FF" StrokeThickness="2" />
                        <TextBlock Canvas.Left="285" Canvas.Top="190" Text="ALLY" FontSize="38" FontWeight="Bold" Foreground="#A99AFF" />
                        <TextBlock Canvas.Left="278" Canvas.Top="232" Text="BINDINGS" FontSize="27" FontWeight="SemiBold" Foreground="#EEF1FF" />

                        <!-- Left stick and click -->
                        <Ellipse Canvas.Left="112" Canvas.Top="137" Width="78" Height="78" Fill="#182235" Stroke="#EEF1FF" StrokeThickness="5" />
                        <Ellipse Canvas.Left="126" Canvas.Top="151" Width="50" Height="50" Fill="#302A59" Stroke="#A99AFF" StrokeThickness="3" />
                        <TextBlock Canvas.Left="143" Canvas.Top="166" Text="L3" FontSize="14" FontWeight="Bold" />

                        <!-- D-pad with every direction visible -->
                        <Path Data="M 126,255 L 151,255 L 151,230 L 178,230 L 178,255 L 203,255 L 203,282 L 178,282 L 178,307 L 151,307 L 151,282 L 126,282 Z"
                              Fill="#253047" Stroke="#EEF1FF" StrokeThickness="3" StrokeLineJoin="Round" />
                        <TextBlock Canvas.Left="158" Canvas.Top="232" Text="↑" FontSize="18" FontWeight="Bold" />
                        <TextBlock Canvas.Left="130" Canvas.Top="258" Text="←" FontSize="18" FontWeight="Bold" />
                        <TextBlock Canvas.Left="183" Canvas.Top="258" Text="→" FontSize="18" FontWeight="Bold" />
                        <TextBlock Canvas.Left="158" Canvas.Top="283" Text="↓" FontSize="18" FontWeight="Bold" />

                        <!-- View and menu -->
                        <Border Canvas.Left="201" Canvas.Top="323" Width="42" Height="30" Background="#253047" BorderBrush="#EEF1FF" BorderThickness="2" CornerRadius="6">
                          <TextBlock Text="▣" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                        </Border>
                        <Border Canvas.Left="457" Canvas.Top="323" Width="42" Height="30" Background="#253047" BorderBrush="#EEF1FF" BorderThickness="2" CornerRadius="6">
                          <TextBlock Text="☰" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                        </Border>

                        <!-- ABXY buttons -->
                        <Ellipse Canvas.Left="530" Canvas.Top="134" Width="42" Height="42" Fill="#263146" Stroke="#F5C56B" StrokeThickness="3" />
                        <Ellipse Canvas.Left="575" Canvas.Top="179" Width="42" Height="42" Fill="#263146" Stroke="#F08BA5" StrokeThickness="3" />
                        <Ellipse Canvas.Left="485" Canvas.Top="179" Width="42" Height="42" Fill="#263146" Stroke="#6EC8FF" StrokeThickness="3" />
                        <Ellipse Canvas.Left="530" Canvas.Top="224" Width="42" Height="42" Fill="#263146" Stroke="#62D6A7" StrokeThickness="3" />
                        <TextBlock Canvas.Left="544" Canvas.Top="143" Text="Y" FontSize="18" FontWeight="Bold" Foreground="#F5C56B" />
                        <TextBlock Canvas.Left="589" Canvas.Top="188" Text="B" FontSize="18" FontWeight="Bold" Foreground="#F08BA5" />
                        <TextBlock Canvas.Left="499" Canvas.Top="188" Text="X" FontSize="18" FontWeight="Bold" Foreground="#6EC8FF" />
                        <TextBlock Canvas.Left="544" Canvas.Top="233" Text="A" FontSize="18" FontWeight="Bold" Foreground="#62D6A7" />

                        <!-- Right stick and click -->
                        <Ellipse Canvas.Left="507" Canvas.Top="276" Width="78" Height="78" Fill="#182235" Stroke="#EEF1FF" StrokeThickness="5" />
                        <Ellipse Canvas.Left="521" Canvas.Top="290" Width="50" Height="50" Fill="#302A59" Stroke="#A99AFF" StrokeThickness="3" />
                        <TextBlock Canvas.Left="537" Canvas.Top="305" Text="R3" FontSize="14" FontWeight="Bold" />

                        <!-- Rear paddles -->
                        <Border Canvas.Left="132" Canvas.Top="388" Width="64" Height="34" Background="#241F42" BorderBrush="#A99AFF" BorderThickness="2" CornerRadius="10">
                          <TextBlock Text="M1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                        </Border>
                        <Border Canvas.Left="504" Canvas.Top="388" Width="64" Height="34" Background="#241F42" BorderBrush="#A99AFF" BorderThickness="2" CornerRadius="10">
                          <TextBlock Text="M2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                        </Border>

                        <!-- Every illustrated control has a real 48-DIP minimum target at the 1040x736 release viewport. Pointer/touch routing chooses the nearest depicted control so overlapping accessibility bounds never make dense D-pad/ABXY controls ambiguous. -->
                        <Button Style="{StaticResource DiagramHitTarget}" Canvas.Left="105" Canvas.Top="53" Width="105" Tag="{x:Static core:ControllerButton.LeftTrigger}" Click="ControllerDiagramButton_Click" ToolTip="Map left trigger" AutomationProperties.AutomationId="Diagram-LeftTrigger" AutomationProperties.Name="Map left trigger" />
                        <Button Style="{StaticResource DiagramHitTarget}" Canvas.Left="490" Canvas.Top="53" Width="105" Tag="{x:Static core:ControllerButton.RightTrigger}" Click="ControllerDiagramButton_Click" ToolTip="Map right trigger" AutomationProperties.AutomationId="Diagram-RightTrigger" AutomationProperties.Name="Map right trigger" />
                        <Button Style="{StaticResource DiagramHitTarget}" Canvas.Left="124" Canvas.Top="79" Width="102" Tag="{x:Static core:ControllerButton.LeftBumper}" Click="ControllerDiagramButton_Click" ToolTip="Map left bumper" AutomationProperties.AutomationId="Diagram-LeftBumper" AutomationProperties.Name="Map left bumper" />
                        <Button Style="{StaticResource DiagramHitTarget}" Canvas.Left="474" Canvas.Top="79" Width="102" Tag="{x:Static core:ControllerButton.RightBumper}" Click="ControllerDiagramButton_Click" ToolTip="Map right bumper" AutomationProperties.AutomationId="Diagram-RightBumper" AutomationProperties.Name="Map right bumper" />
                        <Button Style="{StaticResource DiagramHitTarget}" Canvas.Left="123" Canvas.Top="148" Tag="{x:Static core:ControllerButton.LeftStick}" Click="ControllerDiagramButton_Click" ToolTip="Map left stick click" AutomationProperties.AutomationId="Diagram-LeftStick" AutomationProperties.Name="Map left stick click" />
                        <Button Style="{StaticResource DiagramHitTarget}" Canvas.Left="137" Canvas.Top="216" Tag="{x:Static core:ControllerButton.DPadUp}" Click="ControllerDiagramButton_Click" ToolTip="Map D-pad up" AutomationProperties.AutomationId="Diagram-DPadUp" AutomationProperties.Name="Map D-pad up" />
                        <Button Style="{StaticResource DiagramHitTarget}" Canvas.Left="111" Canvas.Top="241" Tag="{x:Static core:ControllerButton.DPadLeft}" Click="ControllerDiagramButton_Click" ToolTip="Map D-pad left" AutomationProperties.AutomationId="Diagram-DPadLeft" AutomationProperties.Name="Map D-pad left" />
                        <Button Style="{StaticResource DiagramHitTarget}" Canvas.Left="164" Canvas.Top="241" Tag="{x:Static core:ControllerButton.DPadRight}" Click="ControllerDiagramButton_Click" ToolTip="Map D-pad right" AutomationProperties.AutomationId="Diagram-DPadRight" AutomationProperties.Name="Map D-pad right" />
                        <Button Style="{StaticResource DiagramHitTarget}" Canvas.Left="137" Canvas.Top="267" Tag="{x:Static core:ControllerButton.DPadDown}" Click="ControllerDiagramButton_Click" ToolTip="Map D-pad down" AutomationProperties.AutomationId="Diagram-DPadDown" AutomationProperties.Name="Map D-pad down" />
                        <Button Style="{StaticResource DiagramHitTarget}" Canvas.Left="194" Canvas.Top="310" Tag="{x:Static core:ControllerButton.View}" Click="ControllerDiagramButton_Click" ToolTip="Map View button" AutomationProperties.AutomationId="Diagram-View" AutomationProperties.Name="Map View button" />
                        <Button Style="{StaticResource DiagramHitTarget}" Canvas.Left="450" Canvas.Top="310" Tag="{x:Static core:ControllerButton.Menu}" Click="ControllerDiagramButton_Click" ToolTip="Map Menu button" AutomationProperties.AutomationId="Diagram-Menu" AutomationProperties.Name="Map Menu button" />
                        <Button Style="{StaticResource DiagramHitTarget}" Canvas.Left="523" Canvas.Top="127" Tag="{x:Static core:ControllerButton.Y}" Click="ControllerDiagramButton_Click" ToolTip="Map Y button" AutomationProperties.AutomationId="Diagram-Y" AutomationProperties.Name="Map Y button" />
                        <Button Style="{StaticResource DiagramHitTarget}" Canvas.Left="478" Canvas.Top="172" Tag="{x:Static core:ControllerButton.X}" Click="ControllerDiagramButton_Click" ToolTip="Map X button" AutomationProperties.AutomationId="Diagram-X" AutomationProperties.Name="Map X button" />
                        <Button Style="{StaticResource DiagramHitTarget}" Canvas.Left="568" Canvas.Top="172" Tag="{x:Static core:ControllerButton.B}" Click="ControllerDiagramButton_Click" ToolTip="Map B button" AutomationProperties.AutomationId="Diagram-B" AutomationProperties.Name="Map B button" />
                        <Button Style="{StaticResource DiagramHitTarget}" Canvas.Left="523" Canvas.Top="217" Tag="{x:Static core:ControllerButton.A}" Click="ControllerDiagramButton_Click" ToolTip="Map A button" AutomationProperties.AutomationId="Diagram-A" AutomationProperties.Name="Map A button" />
                        <Button Style="{StaticResource DiagramHitTarget}" Canvas.Left="518" Canvas.Top="287" Tag="{x:Static core:ControllerButton.RightStick}" Click="ControllerDiagramButton_Click" ToolTip="Map right stick click" AutomationProperties.AutomationId="Diagram-RightStick" AutomationProperties.Name="Map right stick click" />
                        <Button Style="{StaticResource DiagramHitTarget}" Canvas.Left="136" Canvas.Top="377" Tag="{x:Static core:ControllerButton.M1}" Click="ControllerDiagramButton_Click" ToolTip="Map rear button M1" AutomationProperties.AutomationId="Diagram-M1" AutomationProperties.Name="Map rear button M1" />
                        <Button Style="{StaticResource DiagramHitTarget}" Canvas.Left="508" Canvas.Top="377" Tag="{x:Static core:ControllerButton.M2}" Click="ControllerDiagramButton_Click" ToolTip="Map rear button M2" AutomationProperties.AutomationId="Diagram-M2" AutomationProperties.Name="Map rear button M2" />

                        <TextBlock Canvas.Left="202" Canvas.Top="458" Text="All 18 physical controls are selectable" FontSize="18" Foreground="#AEB5C7" />
                      </Canvas>
                    </Viewbox>
                  </Grid>

                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding RightBindings}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Tag="{Binding Row}" Click="BindingTile_Click" Height="48" Margin="6,0,0,0" Padding="6,3"
                                  HorizontalContentAlignment="Stretch"
                                  AutomationProperties.AutomationId="{Binding AutomationId}"
                                  IsEnabled="{Binding DataContext.CanEditSelected, RelativeSource={RelativeSource AncestorType=Window}}">
                            <AutomationProperties.Name>
                              <MultiBinding StringFormat="{}{0}, mapped to {1}">
                                <Binding Path="Label" /><Binding Path="Row.Target" />
                              </MultiBinding>
                            </AutomationProperties.Name>
                            <Grid>
                              <Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                              <TextBlock Text="‹" Foreground="{StaticResource MutedBrush}" FontSize="18" VerticalAlignment="Center" />
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Row.Target}" Foreground="{StaticResource AccentStrongBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <Border Grid.Column="2" Background="#302A59" BorderBrush="#5E4BB7" BorderThickness="1" CornerRadius="7" Width="30" Height="30">
                                <TextBlock Text="{Binding Glyph}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Background="#111624" BorderBrush="#394157" BorderThickness="1" CornerRadius="10" Padding="3" Margin="6,2,0,0"
                            AutomationProperties.Name="ABXY button mappings">
                      <ItemsControl ItemsSource="{Binding FaceBindings}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Tag="{Binding Row}" Click="BindingTile_Click" Height="48" Margin="1" Padding="3"
                                    AutomationProperties.AutomationId="{Binding AutomationId}" ToolTip="{Binding Row.Target}"
                                    IsEnabled="{Binding DataContext.CanEditSelected, RelativeSource={RelativeSource AncestorType=Window}}">
                              <AutomationProperties.Name>
                                <MultiBinding StringFormat="{}{0}, mapped to {1}">
                                  <Binding Path="Label" /><Binding Path="Row.Target" />
                                </MultiBinding>
                              </AutomationProperties.Name>
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontSize="17" FontWeight="Bold" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding Row.Target}" FontSize="9" Foreground="{StaticResource AccentStrongBrush}" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </StackPanel>
                </Grid>
              </ScrollViewer>
            </Border>
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Touch or click a control · D-pad navigates · A opens binding" Foreground="{StaticResource MutedBrush}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"
                         AutomationProperties.AutomationId="ControllerMapHint" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Reset this layout" Click="ResetBindings_Click" AutomationProperties.AutomationId="ControllerMapReset" />
                <Button Content="X  Save" Click="Save_Click" />
                <Button Content="Y  Select profile" Style="{StaticResource PrimaryButton}" Click="Apply_Click" />
              </StackPanel>
            </Grid>
          </Grid>
        </TabItem>

        <!-- Shortcut -->
        <TabItem>
          <ScrollViewer PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22" MaxWidth="820" HorizontalAlignment="Left">
              <TextBlock Text="Controller shortcut" FontSize="27" FontWeight="SemiBold" />
              <TextBlock Text="Hold the chord, release and repeat to rotate, then stop to commit. Keep holding and press RT to open Ally Bindings."
                         Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,18" />
              <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="24">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Chord button 1" Foreground="{StaticResource MutedBrush}" /><ComboBox ItemsSource="{Binding ButtonOptions}" SelectedItem="{Binding ShortcutButton1}" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Chord button 2" Foreground="{StaticResource MutedBrush}" /><ComboBox ItemsSource="{Binding ButtonOptions}" SelectedItem="{Binding ShortcutButton2}" /></StackPanel>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Hold time" Foreground="{StaticResource MutedBrush}" />
                      <StackPanel Orientation="Horizontal" Margin="0,6,0,12">
                        <Button Content="−" Width="56" MinWidth="56" Click="DecreaseHold_Click" AutomationProperties.Name="Decrease hold time" />
                        <Border Background="#111624" BorderBrush="#394157" BorderThickness="1" CornerRadius="9" Width="130" Height="48" Margin="0,0,10,0">
                          <TextBlock Text="{Binding HoldMilliseconds, StringFormat={}{0} ms}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Button Content="＋" Width="56" MinWidth="56" Click="IncreaseHold_Click" AutomationProperties.Name="Increase hold time" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Commit delay" Foreground="{StaticResource MutedBrush}" />
                      <StackPanel Orientation="Horizontal" Margin="0,6,0,12">
                        <Button Content="−" Width="56" MinWidth="56" Click="DecreaseCommitDelay_Click" AutomationProperties.Name="Decrease commit delay" />
                        <Border Background="#111624" BorderBrush="#394157" BorderThickness="1" CornerRadius="9" Width="130" Height="48" Margin="0,0,10,0">
                          <TextBlock Text="{Binding CommitDelayMilliseconds, StringFormat={}{0} ms}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Button Content="＋" Width="56" MinWidth="56" Click="IncreaseCommitDelay_Click" AutomationProperties.Name="Increase commit delay" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                  <TextBlock x:Name="ShortcutWarningText" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,10" />
                  <Button Content="X  Save shortcut" Style="{StaticResource PrimaryButton}" Click="Save_Click" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
              <Border Background="#151D2B" BorderBrush="#35445B" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,16,0,0">
                <StackPanel>
                  <TextBlock Text="Controller navigation in this app" FontSize="20" FontWeight="SemiBold" />
                  <TextBlock Text="D-pad moves focus · A selects · B returns · LB/RB changes section · X saves · Y selects the current profile."
                             Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- Capture and update -->
        <TabItem>
          <ScrollViewer PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22" MaxWidth="900" HorizontalAlignment="Left">
              <TextBlock Text="Capture &amp; update" FontSize="27" FontWeight="SemiBold" />
              <TextBlock Text="Hardware validation and app maintenance live here—nothing buried below the editor."
                         Foreground="{StaticResource MutedBrush}" Margin="0,5,0,18" />

              <Border Background="#241F42" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="18" Padding="24" Margin="0,0,0,16">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Capture Armoury M1/M2" FontSize="23" FontWeight="SemiBold" />
                    <TextBlock Text="Record filtered candidate mapping reports with Windows USB ETW. No USBPcap, driver, or raw system trace. Windows asks for temporary elevation."
                               Foreground="#CEC7F7" TextWrapping="Wrap" Margin="0,7,24,8" />
                    <TextBlock x:Name="ArmouryCaptureStatusText" Text="Ready to capture the three-step Armoury mapping sequence."
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,24,0" />
                  </StackPanel>
                  <Button x:Name="ArmouryCaptureButton" Grid.Column="1" Style="{StaticResource PrimaryButton}"
                          Content="Start capture" Click="CaptureArmouryProtocol_Click" VerticalAlignment="Center"
                          AutomationProperties.AutomationId="ArmouryCaptureButton"
                          AutomationProperties.Name="Capture Armoury M1 and M2 protocol with Windows ETW" />
                </Grid>
              </Border>

              <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="24" Margin="0,0,0,16">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="App updates" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="UpdateStatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,24,8" />
                    <CheckBox IsChecked="{Binding CheckForUpdatesAutomatically}" Content="Check automatically" />
                    <CheckBox IsChecked="{Binding IncludePrereleaseUpdates}" Content="Include preview releases" />
                  </StackPanel>
                  <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Update app now" Click="CheckForUpdates_Click"
                          VerticalAlignment="Center" AutomationProperties.Name="Check for and install updates now" />
                </Grid>
              </Border>

              <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="24">
                <StackPanel>
                  <TextBlock Text="Safety and startup" FontSize="22" FontWeight="SemiBold" />
                  <TextBlock x:Name="BackendStatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,12" />
                  <CheckBox IsChecked="{Binding EnableAsusRearButtonMappings}" IsEnabled="{Binding CanEnableAsusRearButtonMappings}"
                            Content="Enable ASUS M1/M2 hardware mappings (locked pending physical validation)" />
                  <CheckBox IsChecked="{Binding RunAtStartup}" Content="Run in the tray when I sign in" />
                  <WrapPanel Margin="0,14,0,0">
                    <Button Content="Restore default" Click="Panic_Click" />
                    <Button Content="Copy diagnostics" Click="CopyDiagnostics_Click" />
                    <Button Content="Hide to tray" Click="Hide_Click" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>

      <Border x:Name="BindingPickerOverlay" Grid.ColumnSpan="2" Panel.ZIndex="40" Visibility="Collapsed"
              Background="#F20A0D15" Padding="36">
        <Border Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="2" CornerRadius="20" Padding="24" MaxWidth="560" MaxHeight="540"
                FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,14">
              <TextBlock x:Name="BindingPickerTitle" Text="Choose output" FontSize="26" FontWeight="SemiBold" />
              <TextBlock Text="D-pad chooses · A confirms · B cancels" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <ListBox x:Name="BindingPickerList" Grid.Row="1" MinWidth="430" Background="#111624" BorderThickness="0"
                     ScrollViewer.PanningMode="VerticalOnly" AutomationProperties.Name="Binding output choices">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                </Style>
              </ListBox.ItemContainerStyle>
            </ListBox>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
              <Button Content="B  Cancel" Click="CancelBindingPicker_Click" AutomationProperties.AutomationId="BindingPickerCancel" />
              <Button Content="A  Use this binding" Style="{StaticResource PrimaryButton}" Click="ConfirmBindingPicker_Click"
                      AutomationProperties.AutomationId="BindingPickerConfirm" />
            </StackPanel>
          </Grid>
        </Border>
      </Border>

      <Border x:Name="NameKeyboardOverlay" Grid.ColumnSpan="2" Panel.ZIndex="40" Visibility="Collapsed"
              Background="#F20A0D15" Padding="18">
        <Border Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                CornerRadius="20" Padding="18" MaxWidth="760" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="Rename profile" FontSize="27" FontWeight="SemiBold" />
              <TextBlock Text="D-pad chooses · A types · X deletes · B cancels" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <Border Grid.Row="1" Background="#111624" BorderBrush="#394157" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,10">
              <TextBlock x:Name="NameKeyboardPreview" FontSize="24" MinHeight="32" />
            </Border>
            <ItemsControl x:Name="NameKeyboardKeys" Grid.Row="2" ItemsSource="{Binding OnScreenKeys}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Content="{Binding}" Tag="{Binding}" Click="NameKeyboardKey_Click" MinWidth="48" Height="48" Margin="2"
                          AutomationProperties.AutomationId="{Binding StringFormat=NameKey-{0}}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
              <Button Content="Clear" Click="NameKeyboardClear_Click" AutomationProperties.AutomationId="NameKey-Clear" />
              <Button Content="Space" Click="NameKeyboardSpace_Click" AutomationProperties.AutomationId="NameKey-Space" />
              <Button Content="X  Delete" Click="NameKeyboardDelete_Click" AutomationProperties.AutomationId="NameKey-Delete" />
              <Button Content="B  Cancel" Click="NameKeyboardCancel_Click" AutomationProperties.AutomationId="NameKey-Cancel" />
              <Button Content="A  Done" Style="{StaticResource PrimaryButton}" Click="NameKeyboardDone_Click" AutomationProperties.AutomationId="NameKey-Done" />
            </StackPanel>
          </Grid>
        </Border>
      </Border>

      <Border x:Name="ControllerDialogOverlay" Grid.ColumnSpan="2" Panel.ZIndex="60" Visibility="Collapsed"
              Background="#F20A0D15" Padding="34">
        <Border Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                CornerRadius="20" Padding="26" MaxWidth="680" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock x:Name="ControllerDialogTitle" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap" />
            <ScrollViewer x:Name="ControllerDialogScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" Margin="0,15">
              <TextBlock x:Name="ControllerDialogMessage" FontSize="17" Foreground="#E5E8F2" TextWrapping="Wrap" LineHeight="25" />
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="ControllerDialogSecondaryButton" Content="B  Cancel" Click="ControllerDialogSecondary_Click" />
              <Button x:Name="ControllerDialogPrimaryButton" Content="A  Continue" Style="{StaticResource PrimaryButton}" Click="ControllerDialogPrimary_Click" />
            </StackPanel>
          </Grid>
        </Border>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#121725" BorderBrush="#272E40" BorderThickness="0,1,0,0" Padding="20,8">
      <Grid>
        <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   AutomationProperties.LiveSetting="Polite" />
        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="A Select   B Back   LB/RB Sections   X Save   Y Apply" />
      </Grid>
    </Border>
  </Grid>
</Window>
